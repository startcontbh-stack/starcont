# Variáveis de ambiente da Start Cont (copie para .env e preencha)

# --- Banco de dados (Neon / Postgres) ---
# Fornecidas automaticamente pela integração Neon na Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"        # conexão pooled (app)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require" # conexão direta (migrações)

# --- Painel admin ---
ADMIN_PASSWORD="defina-uma-senha-forte"
SESSION_SECRET="defina-um-segredo-aleatorio-longo"

# --- Site ---
NEXT_PUBLIC_WHATSAPP="5531981211758"
# Domínio próprio. Sem ele, o site usa o domínio de produção da Vercel.
NEXT_PUBLIC_SITE_URL=""
# Código de verificação do Google Search Console (opcional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# ID de conversão do Google Ads da landing page (opcional, ex.: AW-123456789)
NEXT_PUBLIC_GOOGLE_ADS_ID=""

# --- Upload de imagens do blog (Vercel Blob) ---
# Fornecida automaticamente ao criar um Blob Store na Vercel.
BLOB_READ_WRITE_TOKEN=""
