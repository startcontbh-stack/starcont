// Start Cont — schema do banco
// Postgres (Neon na Vercel). DATABASE_URL = conexão pooled;
// DATABASE_URL_UNPOOLED = conexão direta (usada nas migrações).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Post {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  coverImage String?
  content    String // HTML gerado pelo editor
  excerpt    String?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Autor do artigo (contador da equipe) — usado para E-E-A-T / SEO
  author     Author?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?
}

// Profissional da Start Cont que assina os artigos.
// Campos pensados para sinais de E-E-A-T do Google (autoria, credenciais e
// perfis verificáveis via schema.org Person/sameAs).
model Author {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  role       String // cargo, ex.: "Contador · Fundador da Start Cont"
  credential String? // registro profissional, ex.: "CRC-MG 000000/O"
  bio        String // biografia (autoridade / experiência)
  image      String? // foto do profissional
  email      String?
  // Perfis verificáveis (viram sameAs no JSON-LD) — reforçam E-E-A-T
  instagram  String?
  linkedin   String?
  website    String?
  posts      Post[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Envio mensal do cliente pelo portal (/portal): ele informa o faturamento do
// mês e anexa o extrato bancário. O contador vê tudo em /admin/envios.
model Envio {
  id          String  @id @default(cuid())
  nomeCliente String
  empresa     String?
  telefone    String?
  // Mês de referência no formato "AAAA-MM" (ordena como texto, o que mantém
  // o agrupamento por competência simples no painel).
  competencia String
  // Em centavos: evita o arredondamento de float e o Decimal do Prisma, que
  // não atravessa a fronteira server/client component.
  faturamentoCentavos Int?
  semMovimento        Boolean @default(false)
  observacoes         String?
  // Andamento no painel: recebido | em_analise | concluido
  status    String         @default("recebido")
  arquivos  EnvioArquivo[]
  createdAt DateTime       @default(now())

  @@index([competencia])
  @@index([createdAt])
}

// Arquivo anexado a um envio (extrato bancário em PDF, print, notas).
model EnvioArquivo {
  id        String   @id @default(cuid())
  envio     Envio    @relation(fields: [envioId], references: [id], onDelete: Cascade)
  envioId   String
  nome      String // nome original do arquivo, como o cliente enviou
  url       String // Vercel Blob em produção, /uploads em dev
  tipo      String // mime type
  tamanho   Int // bytes
  createdAt DateTime @default(now())

  @@index([envioId])
}

model Lead {
  id           String   @id @default(cuid())
  nome         String
  cidade       String
  telefone     String
  // "Do que você precisa?" do formulário (abrir empresa, IR, etc.)
  interesse    String?
  origem       String   @default("site") // de qual página veio
  // Estágio no funil (Kanban): entrou_em_contato | aguardando_fechamento | fechado
  status       String   @default("entrou_em_contato")
  // Responsável pelo atendimento (lista em responsaveisCrm, @/lib/site)
  profissional String?
  createdAt    DateTime @default(now())
}
